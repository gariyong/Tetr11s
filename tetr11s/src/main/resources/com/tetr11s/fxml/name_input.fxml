<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.tetr11s.app.controller.NameInputController"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        prefWidth="480" prefHeight="640"
        stylesheets="@../css/name_input.css" styleClass="name-input">
        <top>
               <Label text="NEW RECORD!" styleClass="title" BorderPane.alignment="CENTER"/>
        </top>
        <center>
               <VBox alignment="CENTER" spacing="14">
                      <children>
                             <Label text="점수" styleClass="caption"/>
                             <Label fx:id="scoreLabel" styleClass="score-value"/>
                             <Label text="이름을 입력하세요" styleClass="caption"/>
                             <!-- Enter를 누르면 onConfirm 실행 -->
                             <TextField fx:id="nameField" onAction="#onConfirm" styleClass="name-field"/>
                             <Label fx:id="countLabel" styleClass="count"/>
                             <Label fx:id="messageLabel" styleClass="message"/>
                      </children>
               </VBox>
        </center>
        <bottom>
               <Label text="Enter 확인" styleClass="key-hint" BorderPane.alignment="CENTER"/>
        </bottom>
</BorderPane>