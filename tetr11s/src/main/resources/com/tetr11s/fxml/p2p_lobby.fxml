<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
P2P 로비: 연결 직후와 매 판이 끝난 뒤의 대기 화면
서버는 모드를 고르고, 둘 다 '게임 시작'을 누르면 카운트다운 뒤 대전이 시작된다
내용은 P2PLobbyController가 채운다
-->
<BorderPane fx:id="root" fx:controller="com.tetr11s.app.controller.P2PLobbyController"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        prefWidth="480" prefHeight="640"
        stylesheets="@../css/start_menu.css,@../css/p2p.css" styleClass="start-menu"
        focusTraversable="true"
        onKeyPressed="#onKeyPressed"
        onKeyReleased="#onKeyReleased">
        <top>
                <VBox alignment="CENTER" spacing="8">
                        <Label text="LOBBY" styleClass="title"/>
                        <Label fx:id="connectionLabel" styleClass="key-hint"/>
                </VBox>
        </top>
        <center>
                <VBox alignment="CENTER" spacing="14">
                        <Label fx:id="modeCaptionLabel" styleClass="p2p-caption"/>
                        <HBox fx:id="modeBox" alignment="CENTER" spacing="8"/>
                        <Label fx:id="modeDescriptionLabel" styleClass="p2p-sub" wrapText="true"/>
                        <HBox alignment="CENTER" spacing="48">
                                <VBox alignment="CENTER" spacing="4">
                                        <Label text="나" styleClass="p2p-caption"/>
                                        <Label fx:id="myReadyLabel" styleClass="p2p-ready"/>
                                </VBox>
                                <VBox alignment="CENTER" spacing="4">
                                        <Label text="상대" styleClass="p2p-caption"/>
                                        <Label fx:id="peerReadyLabel" styleClass="p2p-ready"/>
                                </VBox>
                        </HBox>
                        <Label fx:id="readyButton" styleClass="menu-item" onMouseClicked="#onReadyClicked"/>
                        <Label fx:id="countdownLabel" styleClass="p2p-countdown"/>
                        <Label fx:id="resultLabel" styleClass="p2p-result"/>
                </VBox>
        </center>
        <bottom>
                <VBox alignment="CENTER" spacing="8">
                        <Label fx:id="networkLabel" styleClass="p2p-network"/>
                        <Label fx:id="messageLabel" styleClass="message" wrapText="true"/>
                        <Label fx:id="keyHintLabel" styleClass="key-hint"/>
                </VBox>
        </bottom>
</BorderPane>
